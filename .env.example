# 复制为 .env.local。所有变量只在服务端使用，不会暴露给浏览器。

# 用哪种协议：anthropic（默认）或 openai
LLM_PROVIDER=anthropic

# ---- Anthropic 协议 ----
ANTHROPIC_API_KEY=
# 可选：兼容 Anthropic 协议的中转 / 代理地址（默认 https://api.anthropic.com）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# 可选：模型 id（默认 claude-opus-5）
# ANTHROPIC_MODEL=claude-opus-5

# ---- OpenAI 协议（OpenAI、DeepSeek、OpenRouter、Ollama、vLLM 等任何兼容服务）----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5
# completions（chat/completions，兼容面最广，默认）或 responses（OpenAI Responses API）
# OPENAI_API=completions
# 是否发送 reasoning_effort：auto（默认，按型号名判断 o1/o3/o4/gpt-5）| true | false
# OPENAI_REASONING=auto

# ---- 数据库 ----
# 本地开发：docker compose up -d 会在 5436 端口启动 Postgres 17
DATABASE_URL=postgres://vibe:vibe@localhost:5436/vibe
