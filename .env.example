# Copy to .env.local. All variables are server-side only and never exposed to the browser.

# Which protocol to use: anthropic (default) or openai
LLM_PROVIDER=anthropic

# ---- Anthropic protocol ----
ANTHROPIC_API_KEY=
# Optional: relay / proxy endpoint that speaks the Anthropic protocol (default https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: model id (default claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# ---- OpenAI protocol (OpenAI, DeepSeek, OpenRouter, Ollama, vLLM, or any compatible service) ----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5
# completions (chat/completions, the most widely compatible, default) or responses (OpenAI Responses API)
# OPENAI_API=completions
# Whether to send reasoning_effort: auto (default, inferred from the model name o1/o3/o4/gpt-5) | true | false
# OPENAI_REASONING=auto

# ---- Database ----
# Local development: `docker compose up -d` starts Postgres 17 on port 5436
DATABASE_URL=postgres://vibe:vibe@localhost:5436/vibe
